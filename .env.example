# Supabase Postgres connection string (Project Settings -> Database -> Connection string).
# Use the session pooler / direct connection URI. "postgresql://" is rewritten to use psycopg automatically.
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
# Legacy HS256 JWT secret (Project Settings -> API -> JWT secret).
# Leave empty if your project uses asymmetric signing keys; tokens are then verified via JWKS from SUPABASE_URL.
SUPABASE_JWT_SECRET=

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
